<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Tours | New York Pedicab Experience</title>
<style>
:root{--navy:#06192d;--navy2:#0b2945;--gold:#ffc84d;--cream:#fbf5e9;--white:#fff;--ink:#10202f}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#fff}
a{text-decoration:none;color:inherit}.wrap{max-width:1450px;margin:auto;padding:0 24px}
header{position:sticky;top:0;z-index:50;background:rgba(3,20,38,.98);border-bottom:1px solid rgba(255,255,255,.12)}
nav{min-height:78px;display:flex;align-items:center;gap:28px}.logo img{width:225px;height:64px;object-fit:contain;background:#faf6ed;border-radius:9px}
.links{margin-left:auto;display:flex;align-items:center;gap:25px}.links a{color:white;font-size:13px;font-weight:800;text-transform:uppercase}.links a:hover{color:var(--gold)}
.book{background:var(--gold)!important;color:#08192b!important;padding:13px 22px;border-radius:14px}
.availability{display:inline-block;background:var(--gold);color:#071827;padding:16px 24px;border-radius:14px;font-weight:900;margin-top:18px;box-shadow:0 6px 18px rgba(0,0,0,.2)}
.hero{min-height:470px;background:linear-gradient(90deg,rgba(2,17,32,.9),rgba(2,17,32,.25)),url('https://images.unsplash.com/photo-1568480289356-5a75d0fd47fc?auto=format&fit=crop&w=1800&q=90') center/cover;display:flex;align-items:center;color:white}
.hero h1{font:700 clamp(48px,7vw,92px)/.95 Georgia,serif;margin:0;max-width:950px}.hero h2{color:var(--gold);font:700 clamp(21px,3vw,35px) Georgia,serif;margin:16px 0}.hero p{font-size:19px;max-width:700px}
.stats{display:flex;gap:35px;flex-wrap:wrap;margin-top:28px;font-weight:800}.stats span{border-left:3px solid var(--gold);padding-left:12px}
section{padding:68px 0}.dark{background:var(--navy);color:white}.title{text-align:center;margin-bottom:35px}.title h2{font:700 46px Georgia,serif;color:var(--navy);margin:5px}.dark .title h2{color:white}.eyebrow{color:#c79427;letter-spacing:.15em;font-weight:900;font-size:12px}
.tours{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;background:var(--navy)}
.tour{min-height:650px;background:#071a2e;color:white;border:1px solid #d5a638;display:flex;flex-direction:column}
.tour img{width:100%;height:235px;object-fit:cover}.tour-body{padding:20px;display:flex;flex-direction:column;flex:1}
.tour h3{font:700 25px Georgia,serif;margin:0 0 6px}.tour .sub{color:var(--gold);font-weight:900;font-size:18px}.tour ul{padding-left:20px;line-height:1.75;font-size:14px;flex:1}.price{font-size:29px;color:var(--gold);font-weight:900}.price small{font-size:13px;color:white}
.btn{display:block;text-align:center;background:var(--gold);color:#071827;padding:14px 15px;border-radius:13px;font-weight:900;margin-top:13px}
.map-preview{background:#09223c;padding:30px;color:white;display:grid;grid-template-columns:2fr 1fr;gap:25px;align-items:center}.map-preview iframe{width:100%;height:330px;border:0;border-radius:16px}.map-preview h2{font:700 36px Georgia,serif;color:var(--gold)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{padding:25px;border:1px solid #ddd;border-radius:18px;background:white}.card h3{font-family:Georgia,serif;color:var(--navy)}
.reviews{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.review{background:white;color:#263645;padding:22px;border-radius:17px}.stars{color:#d59c19;font-size:20px}
footer{background:#031321;color:#dce4e9;padding:40px 0}.footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
.pagehero{background:var(--navy);color:white;padding:70px 0}.pagehero h1{font:700 56px Georgia,serif;margin:0;color:var(--gold)}
@media(max-width:1050px){.tours{grid-template-columns:1fr 1fr}.links a:not(.book){display:none}.cards,.reviews{grid-template-columns:1fr 1fr}}
@media(max-width:650px){.wrap{padding:0 15px}.logo img{width:170px}.hero{min-height:520px}.hero h1{font-size:50px}.tours,.cards,.reviews,.map-preview{grid-template-columns:1fr}.tour{min-height:auto}.tour img{height:230px}.map-preview iframe{height:300px}.links{gap:8px}.book{padding:11px 13px;font-size:11px}}
</style>
</head>
<body>
<header>
<div class="wrap">
<nav>
